# Server
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
DATA_DIR=./data
SECRET_KEY=replace-with-64-plus-random-characters-before-production
SESSION_DAYS=7
COOKIE_SECURE=false
# Set to true ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For.
# When true, the client IP used for rate limiting is read from X-Forwarded-For.
TRUST_PROXY=false
# Single-user mode: no login required — every request is auto-authenticated as one local user.
# ONLY enable on a private, trusted, single-operator deployment (e.g. your own tailnet).
SINGLE_USER_MODE=false

# Market data provider priority: auto | finnhub | twelvedata | yahoo
MARKET_DATA_PROVIDER=auto
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=

# SEC EDGAR requires a descriptive User-Agent. Use your real contact email in production.
SEC_USER_AGENT=k-terminal-finance/1.0 contact@example.com

# DART / OpenDART
DART_API_KEY=

# FRED (US economic release calendar). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# auto-dom local trading bridge (same machine). Terminal is observer/cockpit only — no keys here.
AUTO_DOM_URL=http://127.0.0.1:8765
AUTO_DOM_BRIDGE_TOKEN=
# Path to auto-dom's signal inbox JSONL (for the SIGNALS feed). Relative paths resolve from the project root.
AUTO_DOM_INBOX_PATH=../auto-dom/var/signals/inbox.jsonl
# auto-dom execution audit (for entered-position rationale). Live order log + runtime audit root.
AUTO_DOM_LIVE_AUDIT_PATH=../auto-dom/var/orders/live_audit.jsonl
AUTO_DOM_AUDIT_ROOT=../auto-dom/var/bridge/audit

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=local

# Broker / orders. Defaults are intentionally safe.
TRADING_DEFAULT_MODE=paper
REAL_TRADING_ENABLED=false
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
IBKR_BASE_URL=https://localhost:5000/v1/api
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_PRODUCT_CODE=
KIS_PAPER=true
